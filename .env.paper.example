# US Market Paper Trading Configuration Example
# Safe default — real market data, simulated fills, ZERO live orders.

MARKET=US
TRADING_MODE=paper
DATA_MODE=live
LAYA_MODEL=laya-financial-us-v2
LAYA_MODE=shadow

BROKER_PROVIDER=paper
PAPER_INITIAL_CAPITAL=100000.0

LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_REQUIRED=true

# Execution & Risk Limits
TRADE_WATCHLIST=SPY,AAPL,NVDA,MSFT,TSLA,AMZN,GOOGL,META
TRADE_MAX_PER_ORDER=5000.0
TRADE_MAX_DAILY_LOSS=2000.0
TRADE_MAX_POSITIONS=10
TRADE_STOP_LOSS_PCT=2.0
TRADE_TARGET_PCT=4.0
MAX_DATA_AGE_SECONDS=60

# Kill Switch
EMERGENCY_HALT=false
LOG_LEVEL=INFO
