# Copy this file to .env and fill in your values
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
MODEL=inclusionai/ling-3.0-flash-vl:free

# Optional metadata for OpenRouter analytics
SITE_URL=http://localhost:8502
SITE_NAME=AI-Trading-Agent

# ──────────────────────────────────────────────
# Broker selection: paper (default, FREE) | angel | zerodha
# paper = Yahoo Finance data + simulated fills, NO keys needed
# ──────────────────────────────────────────────
BROKER=paper

# ──────────────────────────────────────────────
# Angel One SmartAPI (optional, FREE — only if BROKER=angel)
# Register FREE at: https://smartapi.angelbroking.com/
# ──────────────────────────────────────────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ──────────────────────────────────────────────
# Zerodha Kite Connect (optional, PAID ~Rs.2000/mo — only if BROKER=zerodha)
# Get keys at: https://kite.trade/ — requires manual daily login
# ──────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ──────────────────────────────────────────────
# Trading Configuration (paper defaults)
# ──────────────────────────────────────────────
TRADE_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,WIPRO,SBIN,TITAN
TRADE_MAX_PER_ORDER=5000
TRADE_RISK_PER_TRADE_PCT=5.0
TRADE_MAX_DAILY_LOSS=2000
TRADE_MAX_POSITIONS=3
TRADE_STOP_LOSS_PCT=2.0
TRADE_TARGET_PCT=4.0
TRADE_MODE=paper
TRADE_PRODUCT=DELIVERY
MARKET_OPEN=09:15
MARKET_CLOSE=15:20
SCAN_INTERVAL_MINUTES=5
SWARM_TOTAL_TREASURY=10000.0
LOG_LEVEL=INFO
