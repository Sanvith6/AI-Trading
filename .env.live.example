# US Market Live Trading Configuration Example
# CRITICAL NOTICE: LIVE_TRADING_ENABLED remains FALSE by default!
# Live execution requires explicit runtime authorization and verified credentials.

MARKET=US
TRADING_MODE=live
DATA_MODE=live
LAYA_MODEL=laya-financial-us-v2
LAYA_MODE=shadow

# US Live Broker Configuration (Alpaca / US Brokerage)
BROKER_PROVIDER=alpaca
US_LIVE_BROKER_URL=https://api.alpaca.markets
ALPACA_LIVE_API_KEY=your_live_alpaca_api_key_here
ALPACA_LIVE_SECRET_KEY=your_live_alpaca_secret_key_here

# Live Trading Safety Gates (MUST BE EXPLICITLY UNLOCKED AT RUNTIME)
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_REQUIRED=true
LIVE_CONFIRMATION_TOKEN=

# Execution & Risk Limits (Immutable RiskEngine Enforced)
TRADE_WATCHLIST=SPY,AAPL,NVDA,MSFT,TSLA
TRADE_MAX_PER_ORDER=5000.0
TRADE_MAX_DAILY_LOSS=2000.0
TRADE_MAX_POSITIONS=10
TRADE_STOP_LOSS_PCT=2.0
TRADE_TARGET_PCT=4.0
MAX_DATA_AGE_SECONDS=60

# Kill Switch
EMERGENCY_HALT=false
LOG_LEVEL=INFO
